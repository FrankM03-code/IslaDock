msgstr "One dot per workspace: click to go to one, the wheel moves to the next. With only one it does not show"

msgid "Herramientas"
msgstr "Tools"

msgid "Clic derecho sobre la isla: temporizador de 5, 15 o 25 minutos, uno a tu medida o un Pomodoro."
msgstr "Right click on the island: a 5, 15 or 25 minute timer, one of your own or a Pomodoro."

msgid "Dock"
msgstr "Dock"

msgid "Íconos"
msgstr "Icons"

